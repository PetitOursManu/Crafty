# Variables d'environnement de Crafty (docker compose les lit dans .env ; dans Coolify : « Environment Variables »).
# Détail : docs/DEPLOIEMENT.md. Rien ici n'est obligatoire pour un essai local.

# --- Réseau ---
# Nombre de proxys de confiance entre le visiteur et Crafty (Cloudflare + Traefik = 2), à VÉRIFIER dans
# Administration → Système → « Adresse IP réelle » : sinon limites par IP, verrouillage et fail2ban visent le proxy.
TRUST_PROXY=false
# 1 derrière HTTPS (cookies « Secure » même si le proxy ne transmet pas X-Forwarded-Proto).
COOKIE_SECURE=0
# Adresse publique de Crafty, sans / final (nécessaire au SSO Dashy).
PUBLIC_ORIGIN=

# --- Secrets ---
# Chiffre en base les clés des fournisseurs d'IA et les secrets de double authentification. À générer une fois
# (openssl rand -base64 48) et à GARDER : le changer rend ces secrets illisibles (double authentification à refaire).
CRAFTY_SECRET=
# Coût du hachage des mots de passe (environ 100 ms) : mesurer sur le VPS avec node scripts/scrypt-bench.mjs.
SCRYPT_N=32768

# --- Connexion unique avec Dashy (désactivée si un des trois manque) ---
SSO_SHARED_SECRET=
SSO_DASHY_URL=

# --- Sauvegardes de la base (instantanés dans /data/backups) ---
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# --- Divers ---
# Mémoire du cache de compression à la volée (les applications sont précompressées au build, sur disque).
STATIC_CACHE_MB=64
# Build : qualité Brotli de la précompression (11 en production ; 5 pour un essai rapide).
PRECOMPRESS_QUALITY=11
