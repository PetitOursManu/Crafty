{
  "name": "craft-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prototype phase 0 : héberger les applications web Craft derrière une page hôte",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "start": "node server.js",
    "fetch": "node scripts/fetch-app.mjs",
    "verify-vendor": "node scripts/verify-vendor.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/apps.e2e.mjs",
    "samples": "node scripts/make-samples.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
